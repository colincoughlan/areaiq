# Mapbox — https://account.mapbox.com/access-tokens/ (free tier fine)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Census ACS ingestion — free key: https://api.census.gov/data/key_signup.html
# Run: npm run ingest:acs
CENSUS_API_KEY=

# Ask AreaIQ — https://console.anthropic.com/ (model override optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Local Offers — create a free project at supabase.com, run the migrations in
# supabase/migrations/, then set these. Without them, offers run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
